# Copy to .env.local and fill in. Never commit .env.local.
#
# Local dev values come from `npx supabase start` output (well-known local dev
# defaults, not secrets). Cloud values come from the Supabase project dashboard
# (Project Settings -> API) -- use the Singapore-region project for this app.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Server-only. Never expose this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
